#!/bin/sh

# Generates a file suitable for importing into GIMP based on
# playpal-base.lmp, and placed into doom.gpl

# File header
cat > doom.gpl <<EOF
GIMP Palette
Name: Doom
Columns: 16
#
EOF

# -v disables od's suppression of duplicate lines, which would
# otherwise replace consecutive identical colors with a '*'.
# -w is a GNU extension, so group bytes into RGB triples with xargs
# instead, which also works on macOS and BSD.
od -An -v -tu1 playpal-base.lmp | xargs -n 3 printf '%4d%4d%4d\n' >> doom.gpl
